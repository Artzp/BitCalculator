// ============================================================================
// BITCRAFT DATABASE MIGRATION SERVICE
// ============================================================================
// Complete service for migrating from embedded to normalized database structure
// Handles data extraction, validation, transformation, and migration
// ============================================================================

import { 
  collection, 
  doc, 
  getDocs, 
  getDoc, 
  writeBatch, 
  query, 
  where, 
  orderBy, 
  limit,
  serverTimestamp,
  runTransaction,
  DocumentReference,
  QueryDocumentSnapshot,
  WriteBatch
} from 'firebase/firestore';
import { db } from '../firebase/config';
import { 
  LegacyUserData, 
  NormalizedUserData, 
  NormalizedSettlement, 
  NormalizedProject, 
  NormalizedTask,
  NormalizedProjectCollaboration,
  NormalizedBuildList,
  MigrationResult,
  MigrationStatus,
  MigrationStats
} from '../types/NormalizedDatabase';
import { 
  transformUserData, 
  transformSettlementData, 
  transformProjectData, 
  transformTaskData,
  transformCollaborationData,
  transformBuildListData,
  validateNormalizedData,
  generateId
} from '../utils/migrationUtilities';

// ============================================================================
// MIGRATION SERVICE CLASS
// ============================================================================

export class MigrationService {
  private batchSize = 50; // Firestore batch limit
  private maxRetries = 3;
  private migrationId: string;
  private stats: MigrationStats = {
    totalUsers: 0,
    migratedUsers: 0,
    totalSettlements: 0,
    migratedSettlements: 0,
    totalProjects: 0,
    migratedProjects: 0,
    totalTasks: 0,
    migratedTasks: 0,
    totalCollaborations: 0,
    migratedCollaborations: 0,
    totalBuildLists: 0,
    migratedBuildLists: 0,
    errors: [],
    startTime: null,
    endTime: null
  };

  constructor() {
    this.migrationId = `migration_${Date.now()}`;
  }

  // ========================================================================
  // MAIN MIGRATION ORCHESTRATOR
  // ========================================================================

  async executeMigration(): Promise<MigrationResult> {
    console.log('🚀 Starting database migration to normalized structure...');
    this.stats.startTime = serverTimestamp();
    
    try {
      // Step 1: Pre-migration validation
      await this.validateMigrationPreconditions();
      
      // Step 2: Extract and analyze legacy data
      const legacyData = await this.extractLegacyData();
      
      // Step 3: Transform to normalized format
      const normalizedData = await this.transformLegacyData(legacyData);
      
      // Step 4: Validate normalized data
      await this.validateNormalizedData(normalizedData);
      
      // Step 5: Execute migration in phases
      await this.executePhasedMigration(normalizedData);
      
      // Step 6: Post-migration validation
      await this.validateMigrationComplete();
      
      // Step 7: Update migration status
      await this.updateMigrationStatus('completed');
      
      this.stats.endTime = serverTimestamp();
      
      return {
        success: true,
        migrationId: this.migrationId,
        stats: this.stats,
        message: 'Migration completed successfully'
      };
      
    } catch (error) {
      console.error('❌ Migration failed:', error);
      this.stats.errors.push({
        type: 'migration_failure',
        message: error.message,
        timestamp: serverTimestamp()
      });
      
      await this.updateMigrationStatus('failed');
      
      return {
        success: false,
        migrationId: this.migrationId,
        stats: this.stats,
        error: error.message
      };
    }
  }

  // ========================================================================
  // PRE-MIGRATION VALIDATION
  // ========================================================================

  private async validateMigrationPreconditions(): Promise<void> {
    console.log('🔍 Validating migration preconditions...');
    
    // Check if migration is already in progress
    const migrationStatusRef = doc(db, 'migration_status', 'current');
    const migrationStatusSnap = await getDoc(migrationStatusRef);
    
    if (migrationStatusSnap.exists() && migrationStatusSnap.data().status === 'in_progress') {
      throw new Error('Migration already in progress');
    }
    
    // Check if normalized collections already exist with data
    const normalizedCollections = [
      'users_v2', 'settlements_v2', 'projects_v2', 'tasks_v2', 
      'project_collaborations_v2', 'build_lists_v2'
    ];
    
    for (const collectionName of normalizedCollections) {
      const collectionRef = collection(db, collectionName);
      const snapshot = await getDocs(query(collectionRef, limit(1)));
      
      if (!snapshot.empty) {
        throw new Error(`Normalized collection ${collectionName} already contains data`);
      }
    }
    
    // Set migration status to in_progress
    await this.updateMigrationStatus('in_progress');
  }

  // ========================================================================
  // LEGACY DATA EXTRACTION
  // ========================================================================

  private async extractLegacyData(): Promise<{
    users: LegacyUserData[];
    collaborations: any[];
    sharedProjects: any[];
  }> {
    console.log('📊 Extracting legacy data...');
    
    // Extract legacy users with embedded data
    const usersRef = collection(db, 'users');
    const usersSnapshot = await getDocs(usersRef);
    const users: LegacyUserData[] = [];
    
    for (const userDoc of usersSnapshot.docs) {
      const userData = userDoc.data() as LegacyUserData;
      userData.id = userDoc.id;
      users.push(userData);
    }
    
    // Extract legacy collaborations
    const collaborationsRef = collection(db, 'projectCollaborations');
    const collaborationsSnapshot = await getDocs(collaborationsRef);
    const collaborations = collaborationsSnapshot.docs.map(doc => ({
      id: doc.id,
      ...doc.data()
    }));
    
    // Extract legacy shared projects
    const sharedProjectsRef = collection(db, 'sharedProjects');
    const sharedProjectsSnapshot = await getDocs(sharedProjectsRef);
    const sharedProjects = sharedProjectsSnapshot.docs.map(doc => ({
      id: doc.id,
      ...doc.data()
    }));
    
    // Update stats
    this.stats.totalUsers = users.length;
    this.stats.totalCollaborations = collaborations.length;
    
    // Calculate totals for embedded data
    users.forEach(user => {
      if (user.settlement?.projects) {
        this.stats.totalProjects += user.settlement.projects.length;
        
        user.settlement.projects.forEach(project => {
          if (project.tasks) {
            this.stats.totalTasks += project.tasks.length;
          }
        });
      }
      
      if (user.settlement) {
        this.stats.totalSettlements += 1;
      }
      
      if (user.buildList) {
        this.stats.totalBuildLists += 1;
      }
    });
    
    console.log(`📊 Extracted: ${users.length} users, ${collaborations.length} collaborations, ${sharedProjects.length} shared projects`);
    
    return { users, collaborations, sharedProjects };
  }

  // ========================================================================
  // DATA TRANSFORMATION
  // ========================================================================

  private async transformLegacyData(legacyData: {
    users: LegacyUserData[];
    collaborations: any[];
    sharedProjects: any[];
  }): Promise<{
    users: NormalizedUserData[];
    settlements: NormalizedSettlement[];
    projects: NormalizedProject[];
    tasks: NormalizedTask[];
    collaborations: NormalizedProjectCollaboration[];
    buildLists: NormalizedBuildList[];
  }> {
    console.log('🔄 Transforming legacy data to normalized format...');
    
    const normalizedData = {
      users: [] as NormalizedUserData[],
      settlements: [] as NormalizedSettlement[],
      projects: [] as NormalizedProject[],
      tasks: [] as NormalizedTask[],
      collaborations: [] as NormalizedProjectCollaboration[],
      buildLists: [] as NormalizedBuildList[]
    };
    
    // Transform users and their embedded data
    for (const legacyUser of legacyData.users) {
      try {
        // Transform user profile
        const normalizedUser = transformUserData(legacyUser);
        normalizedData.users.push(normalizedUser);
        
        // Transform settlement if exists
        if (legacyUser.settlement) {
          const normalizedSettlement = transformSettlementData(legacyUser.settlement, legacyUser.id);
          normalizedData.settlements.push(normalizedSettlement);
          
          // Transform projects if exist
          if (legacyUser.settlement.projects) {
            for (const legacyProject of legacyUser.settlement.projects) {
              const normalizedProject = transformProjectData(legacyProject, legacyUser.id, normalizedSettlement.id);
              normalizedData.projects.push(normalizedProject);
              
              // Transform tasks if exist
              if (legacyProject.tasks) {
                for (const legacyTask of legacyProject.tasks) {
                  const normalizedTask = transformTaskData(legacyTask, normalizedProject.id, legacyUser.id);
                  normalizedData.tasks.push(normalizedTask);
                }
              }
            }
          }
        }
        
        // Transform build list if exists
        if (legacyUser.buildList) {
          const settlementId = normalizedData.settlements.find(s => s.ownerId === legacyUser.id)?.id;
          if (settlementId) {
            const normalizedBuildList = transformBuildListData(legacyUser.buildList, legacyUser.id, settlementId);
            normalizedData.buildLists.push(normalizedBuildList);
          }
        }
        
      } catch (error) {
        console.error(`❌ Failed to transform user ${legacyUser.id}:`, error);
        this.stats.errors.push({
          type: 'transformation_error',
          entityType: 'user',
          entityId: legacyUser.id,
          message: error.message,
          timestamp: serverTimestamp()
        });
      }
    }
    
    // Transform collaborations
    for (const legacyCollaboration of legacyData.collaborations) {
      try {
        const normalizedCollaboration = transformCollaborationData(legacyCollaboration);
        normalizedData.collaborations.push(normalizedCollaboration);
      } catch (error) {
        console.error(`❌ Failed to transform collaboration ${legacyCollaboration.id}:`, error);
        this.stats.errors.push({
          type: 'transformation_error',
          entityType: 'collaboration',
          entityId: legacyCollaboration.id,
          message: error.message,
          timestamp: serverTimestamp()
        });
      }
    }
    
    console.log(`🔄 Transformed: ${normalizedData.users.length} users, ${normalizedData.settlements.length} settlements, ${normalizedData.projects.length} projects, ${normalizedData.tasks.length} tasks`);
    
    return normalizedData;
  }

  // ========================================================================
  // NORMALIZED DATA VALIDATION
  // ========================================================================

  private async validateNormalizedData(normalizedData: any): Promise<void> {
    console.log('✅ Validating normalized data...');
    
    const validationErrors: string[] = [];
    
    // Validate users
    for (const user of normalizedData.users) {
      const errors = validateNormalizedData('user', user);
      if (errors.length > 0) {
        validationErrors.push(`User ${user.id}: ${errors.join(', ')}`);
      }
    }
    
    // Validate settlements
    for (const settlement of normalizedData.settlements) {
      const errors = validateNormalizedData('settlement', settlement);
      if (errors.length > 0) {
        validationErrors.push(`Settlement ${settlement.id}: ${errors.join(', ')}`);
      }
    }
    
    // Validate projects
    for (const project of normalizedData.projects) {
      const errors = validateNormalizedData('project', project);
      if (errors.length > 0) {
        validationErrors.push(`Project ${project.id}: ${errors.join(', ')}`);
      }
    }
    
    // Validate tasks
    for (const task of normalizedData.tasks) {
      const errors = validateNormalizedData('task', task);
      if (errors.length > 0) {
        validationErrors.push(`Task ${task.id}: ${errors.join(', ')}`);
      }
    }
    
    if (validationErrors.length > 0) {
      throw new Error(`Validation failed: ${validationErrors.join('; ')}`);
    }
  }

  // ========================================================================
  // PHASED MIGRATION EXECUTION
  // ========================================================================

  private async executePhasedMigration(normalizedData: any): Promise<void> {
    console.log('🚀 Executing phased migration...');
    
    // Phase 1: Migrate users (foundation)
    await this.migrateUsers(normalizedData.users);
    
    // Phase 2: Migrate settlements (depends on users)
    await this.migrateSettlements(normalizedData.settlements);
    
    // Phase 3: Migrate projects (depends on settlements)
    await this.migrateProjects(normalizedData.projects);
    
    // Phase 4: Migrate tasks (depends on projects)
    await this.migrateTasks(normalizedData.tasks);
    
    // Phase 5: Migrate collaborations (depends on projects)
    await this.migrateCollaborations(normalizedData.collaborations);
    
    // Phase 6: Migrate build lists (depends on settlements)
    await this.migrateBuildLists(normalizedData.buildLists);
  }

  // ========================================================================
  // INDIVIDUAL MIGRATION METHODS
  // ========================================================================

  private async migrateUsers(users: NormalizedUserData[]): Promise<void> {
    console.log(`👥 Migrating ${users.length} users...`);
    
    const batches = this.createBatches(users, this.batchSize);
    
    for (const batch of batches) {
      await this.executeBatch('users_v2', batch);
      this.stats.migratedUsers += batch.length;
    }
  }

  private async migrateSettlements(settlements: NormalizedSettlement[]): Promise<void> {
    console.log(`🏘️ Migrating ${settlements.length} settlements...`);
    
    const batches = this.createBatches(settlements, this.batchSize);
    
    for (const batch of batches) {
      await this.executeBatch('settlements_v2', batch);
      this.stats.migratedSettlements += batch.length;
    }
  }

  private async migrateProjects(projects: NormalizedProject[]): Promise<void> {
    console.log(`📋 Migrating ${projects.length} projects...`);
    
    const batches = this.createBatches(projects, this.batchSize);
    
    for (const batch of batches) {
      await this.executeBatch('projects_v2', batch);
      this.stats.migratedProjects += batch.length;
    }
  }

  private async migrateTasks(tasks: NormalizedTask[]): Promise<void> {
    console.log(`✅ Migrating ${tasks.length} tasks...`);
    
    const batches = this.createBatches(tasks, this.batchSize);
    
    for (const batch of batches) {
      await this.executeBatch('tasks_v2', batch);
      this.stats.migratedTasks += batch.length;
    }
  }

  private async migrateCollaborations(collaborations: NormalizedProjectCollaboration[]): Promise<void> {
    console.log(`🤝 Migrating ${collaborations.length} collaborations...`);
    
    const batches = this.createBatches(collaborations, this.batchSize);
    
    for (const batch of batches) {
      await this.executeBatch('project_collaborations_v2', batch);
      this.stats.migratedCollaborations += batch.length;
    }
  }

  private async migrateBuildLists(buildLists: NormalizedBuildList[]): Promise<void> {
    console.log(`🔨 Migrating ${buildLists.length} build lists...`);
    
    const batches = this.createBatches(buildLists, this.batchSize);
    
    for (const batch of batches) {
      await this.executeBatch('build_lists_v2', batch);
      this.stats.migratedBuildLists += batch.length;
    }
  }

  // ========================================================================
  // BATCH EXECUTION UTILITIES
  // ========================================================================

  private createBatches<T>(items: T[], batchSize: number): T[][] {
    const batches: T[][] = [];
    for (let i = 0; i < items.length; i += batchSize) {
      batches.push(items.slice(i, i + batchSize));
    }
    return batches;
  }

  private async executeBatch(collectionName: string, batch: any[]): Promise<void> {
    let retries = 0;
    
    while (retries < this.maxRetries) {
      try {
        const batchOperation = writeBatch(db);
        
        for (const item of batch) {
          const docRef = doc(db, collectionName, item.id);
          batchOperation.set(docRef, item);
        }
        
        await batchOperation.commit();
        return;
        
      } catch (error) {
        retries++;
        if (retries >= this.maxRetries) {
          throw new Error(`Failed to execute batch after ${this.maxRetries} retries: ${error.message}`);
        }
        
        console.warn(`⚠️ Batch execution failed, retrying (${retries}/${this.maxRetries}):`, error);
        await new Promise(resolve => setTimeout(resolve, 1000 * retries));
      }
    }
  }

  // ========================================================================
  // POST-MIGRATION VALIDATION
  // ========================================================================

  private async validateMigrationComplete(): Promise<void> {
    console.log('🔍 Validating migration completion...');
    
    // Check data counts match
    const validationErrors: string[] = [];
    
    if (this.stats.migratedUsers !== this.stats.totalUsers) {
      validationErrors.push(`User count mismatch: ${this.stats.migratedUsers}/${this.stats.totalUsers}`);
    }
    
    if (this.stats.migratedSettlements !== this.stats.totalSettlements) {
      validationErrors.push(`Settlement count mismatch: ${this.stats.migratedSettlements}/${this.stats.totalSettlements}`);
    }
    
    if (this.stats.migratedProjects !== this.stats.totalProjects) {
      validationErrors.push(`Project count mismatch: ${this.stats.migratedProjects}/${this.stats.totalProjects}`);
    }
    
    if (this.stats.migratedTasks !== this.stats.totalTasks) {
      validationErrors.push(`Task count mismatch: ${this.stats.migratedTasks}/${this.stats.totalTasks}`);
    }
    
    if (validationErrors.length > 0) {
      throw new Error(`Migration validation failed: ${validationErrors.join('; ')}`);
    }
    
    // Test data integrity with sample queries
    await this.testDataIntegrity();
  }

  private async testDataIntegrity(): Promise<void> {
    console.log('🧪 Testing data integrity...');
    
    // Test user-settlement relationships
    const usersRef = collection(db, 'users_v2');
    const usersSnapshot = await getDocs(query(usersRef, limit(5)));
    
    for (const userDoc of usersSnapshot.docs) {
      const userId = userDoc.id;
      const settlementsRef = collection(db, 'settlements_v2');
      const userSettlements = await getDocs(query(settlementsRef, where('ownerId', '==', userId)));
      
      if (userSettlements.empty) {
        console.warn(`⚠️ User ${userId} has no settlements`);
      }
    }
    
    console.log('✅ Data integrity tests passed');
  }

  // ========================================================================
  // MIGRATION STATUS MANAGEMENT
  // ========================================================================

  private async updateMigrationStatus(status: 'in_progress' | 'completed' | 'failed'): Promise<void> {
    const migrationStatusRef = doc(db, 'migration_status', 'current');
    
    await runTransaction(db, async (transaction) => {
      transaction.set(migrationStatusRef, {
        status,
        migrationId: this.migrationId,
        timestamp: serverTimestamp(),
        stats: this.stats
      });
    });
  }

  // ========================================================================
  // ROLLBACK FUNCTIONALITY
  // ========================================================================

  async rollbackMigration(): Promise<void> {
    console.log('🔄 Rolling back migration...');
    
    const normalizedCollections = [
      'users_v2', 'settlements_v2', 'projects_v2', 'tasks_v2', 
      'project_collaborations_v2', 'build_lists_v2'
    ];
    
    for (const collectionName of normalizedCollections) {
      const collectionRef = collection(db, collectionName);
      const snapshot = await getDocs(collectionRef);
      
      const batches = this.createBatches(snapshot.docs, this.batchSize);
      
      for (const batch of batches) {
        const batchOperation = writeBatch(db);
        
        for (const doc of batch) {
          batchOperation.delete(doc.ref);
        }
        
        await batchOperation.commit();
      }
    }
    
    await this.updateMigrationStatus('failed');
    console.log('✅ Migration rollback completed');
  }

  // ========================================================================
  // MIGRATION MONITORING
  // ========================================================================

  getStats(): MigrationStats {
    return { ...this.stats };
  }

  async getMigrationStatus(): Promise<MigrationStatus | null> {
    const migrationStatusRef = doc(db, 'migration_status', 'current');
    const snapshot = await getDoc(migrationStatusRef);
    
    if (snapshot.exists()) {
      return snapshot.data() as MigrationStatus;
    }
    
    return null;
  }
}

// ============================================================================
// MIGRATION EXECUTION HELPERS
// ============================================================================

export async function executeMigration(): Promise<MigrationResult> {
  const migrationService = new MigrationService();
  return await migrationService.executeMigration();
}

export async function rollbackMigration(): Promise<void> {
  const migrationService = new MigrationService();
  await migrationService.rollbackMigration();
}

export async function getMigrationStats(): Promise<MigrationStats> {
  const migrationService = new MigrationService();
  return migrationService.getStats();
}

export async function getMigrationStatus(): Promise<MigrationStatus | null> {
  const migrationService = new MigrationService();
  return await migrationService.getMigrationStatus();
}

// ============================================================================
// EXPORT DEFAULT
// ============================================================================

export default MigrationService; 