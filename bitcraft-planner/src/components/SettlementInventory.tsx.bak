import React, { useState } from 'react';
import { useSettlementStore } from '../state/useSettlementStore';
import { useItemsStore } from '../state/useItemsStore';

const SettlementInventory: React.FC = () => {
  const { 
    settlement, 
    addInventoryItem, 
    updateInventoryItem, 
    removeInventoryItem,
    getLowStockItems 
  } = useSettlementStore();
  
  const { items } = useItemsStore();

  const [showAddForm, setShowAddForm] = useState(false);
  const [newItemId, setNewItemId] = useState('');
  const [newQuantity, setNewQuantity] = useState(1);
  const [newStorageLocation, setNewStorageLocation] = useState('');
  const [searchTerm, setSearchTerm] = useState('');

  const handleAddItem = () => {
    if (newItemId && newQuantity > 0) {
      const item = items[newItemId];
      if (item) {
        addInventoryItem(
          newItemId, 
          item.name, 
          newQuantity, 
          newStorageLocation.trim() || undefined
        );
        setNewItemId('');
        setNewQuantity(1);
        setNewStorageLocation('');
        setShowAddForm(false);
      }
    }
  };

  const handleUpdateQuantity = (itemId: string, quantity: number) => {
    if (quantity > 0) {
      updateInventoryItem(itemId, { quantity });
    }
  };

  const handleUpdateStorageLocation = (itemId: string, storageLocation: string) => {
    updateInventoryItem(itemId, { storageLocation });
  };

  const handleRemoveItem = (itemId: string) => {
    if (window.confirm('Are you sure you want to remove this item from the settlement inventory?')) {
      removeInventoryItem(itemId);
    }
  };

  const getFilteredItems = () => {
    if (!settlement) return [];
    
    const inventoryItems = Object.values(settlement.inventory);
    
    if (!searchTerm.trim()) return inventoryItems;
    
    const searchLower = searchTerm.toLowerCase();
    return inventoryItems.filter(item => 
      item.itemName.toLowerCase().includes(searchLower) ||
      (item.storageLocation && item.storageLocation.toLowerCase().includes(searchLower))
    );
  };

  const getAvailableItems = () => {
    if (!settlement) return [];
    
    return Object.entries(items).filter(([itemId, item]) => 
      !settlement.inventory[itemId] && 
      item.name.toLowerCase().includes(newItemId.toLowerCase())
    );
  };

  if (!settlement) {
    return (
      <div className="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
        <div className="text-center">
          <div className="text-gray-500 text-lg">No settlement data available</div>
        </div>
      </div>
    );
  }

  const filteredItems = getFilteredItems();
  const lowStockItems = getLowStockItems();
  const totalItems = filteredItems.length;
  const totalQuantity = filteredItems.reduce((sum, item) => sum + item.quantity, 0);

  return (
    <div className="space-y-6">
      {/* Add Item Section */}
      <div className="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
        <div className="flex items-center justify-between mb-4">
          <h2 className="text-xl font-bold text-slate-800">Settlement Inventory</h2>
          <button
            onClick={() => setShowAddForm(!showAddForm)}
            className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
          >
            {showAddForm ? 'Cancel' : 'Add Item'}
          </button>
        </div>

        {showAddForm && (
          <div className="space-y-4 border-t pt-4">
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-2">
                Item
              </label>
              <select
                value={newItemId}
                onChange={(e) => setNewItemId(e.target.value)}
                className="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              >
                <option value="">Select an item...</option>
                {Object.entries(items).map(([itemId, item]) => (
                  <option key={itemId} value={itemId}>
                    {item.name} (Tier {item.tier})
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-2">
                Quantity
              </label>
              <input
                type="number"
                min="1"
                value={newQuantity}
                onChange={(e) => setNewQuantity(parseInt(e.target.value) || 1)}
                className="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-2">
                Storage Location (Optional)
              </label>
              <input
                type="text"
                placeholder="e.g., Storage Room A, Chest 1..."
                value={newStorageLocation}
                onChange={(e) => setNewStorageLocation(e.target.value)}
                className="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>
            <div className="flex gap-3">
              <button
                onClick={handleAddItem}
                disabled={!newItemId || newQuantity <= 0}
                className="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 disabled:bg-gray-400 disabled:cursor-not-allowed transition-colors"
              >
                Add Item
              </button>
              <button
                onClick={() => {
                  setShowAddForm(false);
                  setNewItemId('');
                  setNewQuantity(1);
                  setNewStorageLocation('');
                }}
                className="px-6 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors"
              >
                Cancel
              </button>
            </div>
          </div>
        )}
      </div>

      {/* Search and Stats */}
      <div className="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
        <div className="flex flex-col md:flex-row md:items-center gap-4">
          <div className="flex-1">
            <input
              type="text"
              placeholder="Search items or storage locations..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>
          <div className="flex gap-4">
            <div className="text-center">
              <div className="text-lg font-bold text-slate-800">{totalItems}</div>
              <div className="text-sm text-slate-600">Items</div>
            </div>
            <div className="text-center">
              <div className="text-lg font-bold text-slate-800">{totalQuantity}</div>
              <div className="text-sm text-slate-600">Total Quantity</div>
            </div>
          </div>
        </div>
      </div>

      {/* Low Stock Alert */}
      {lowStockItems.length > 0 && (
        <div className="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
          <h3 className="text-lg font-bold text-slate-800 mb-4">⚠️ Low Stock Alert</h3>
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {lowStockItems.map((item) => (
              <div key={item.itemId} className="p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                <div className="font-semibold text-yellow-800">{item.itemName}</div>
                <div className="text-sm text-yellow-700">
                  Only {item.availableQuantity} available
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Inventory Items */}
      <div className="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
        <div className="flex items-center justify-between mb-4">
          <h3 className="text-lg font-bold text-slate-800">Inventory Items</h3>
          <span className="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-semibold">
            {filteredItems.length} items
          </span>
        </div>

        {filteredItems.length === 0 ? (
          <div className="text-center py-8">
            <div className="text-gray-400 text-4xl mb-4">📦</div>
            <p className="text-slate-500 text-lg">
              {searchTerm ? 'No items match your search' : 'No items in inventory yet'}
            </p>
            <p className="text-slate-400 text-sm mt-2">
              {searchTerm ? 'Try adjusting your search terms' : 'Add items to track settlement inventory'}
            </p>
          </div>
        ) : (
          <div className="space-y-3">
            {filteredItems.map((item) => (
              <div
                key={item.itemId}
                className="p-4 border border-slate-200 rounded-lg hover:shadow-md transition-shadow"
              >
                <div className="flex items-center justify-between">
                  <div className="flex-1">
                    <h4 className="font-semibold text-slate-800">{item.itemName}</h4>
                    <div className="flex items-center gap-4 mt-1">
                      <span className="text-sm text-slate-600">
                        Quantity: <span className="font-medium">{item.quantity}</span>
                      </span>
                      <span className="text-sm text-slate-600">
                        Available: <span className="font-medium">{item.availableQuantity}</span>
                      </span>
                      {item.reservedQuantity > 0 && (
                        <span className="text-sm text-orange-600">
                          Reserved: <span className="font-medium">{item.reservedQuantity}</span>
                        </span>
                      )}
                    </div>
                    {item.storageLocation && (
                      <div className="text-sm text-slate-500 mt-1">
                        📍 {item.storageLocation}
                      </div>
                    )}
                    <div className="text-xs text-slate-400 mt-1">
                      Added {new Date(item.dateAdded).toLocaleDateString()}
                    </div>
                  </div>
                  
                  <div className="flex items-center gap-2">
                    <button
                      onClick={() => {
                        const newQuantity = prompt('Enter new quantity:', item.quantity.toString());
                        if (newQuantity && !isNaN(parseInt(newQuantity))) {
                          handleUpdateQuantity(item.itemId, parseInt(newQuantity));
                        }
                      }}
                      className="px-3 py-1 bg-blue-600 text-white rounded text-sm hover:bg-blue-700 transition-colors"
                    >
                      Update
                    </button>
                    <button
                      onClick={() => {
                        const newLocation = prompt('Enter storage location:', item.storageLocation || '');
                        if (newLocation !== null) {
                          handleUpdateStorageLocation(item.itemId, newLocation);
                        }
                      }}
                      className="px-3 py-1 bg-green-600 text-white rounded text-sm hover:bg-green-700 transition-colors"
                    >
                      Location
                    </button>
                    <button
                      onClick={() => handleRemoveItem(item.itemId)}
                      className="px-3 py-1 bg-red-600 text-white rounded text-sm hover:bg-red-700 transition-colors"
                    >
                      Remove
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
};

export default SettlementInventory; 