rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Test document for connectivity checks
    match /test/{document} {
      allow read, write: if request.auth != null;
    }
    
    // Public game data that everyone can read
    match /gameData/{document} {
      allow read: if true;
      allow write: if false; // Only admins can write (manually)
    }
    
    // Shared builds that users can share publicly
    match /sharedBuilds/{buildId} {
      allow read: if true;
      allow create: if request.auth != null 
        && validateSharedBuild(request.resource.data);
      allow update, delete: if request.auth != null 
        && request.auth.uid == resource.data.authorId;
    }
    
    // User preferences and settings
    match /userSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Statistics and analytics (read-only for users)
    match /statistics/{document} {
      allow read: if request.auth != null;
      allow write: if false; // Only backend functions can write
    }
    
    // Functions to validate data
    function validateSharedBuild(data) {
      return data.keys().hasAll(['name', 'description', 'buildList', 'authorId', 'createdAt'])
        && data.name is string
        && data.description is string
        && data.buildList is list
        && data.authorId is string
        && data.createdAt is timestamp;
    }
  }
} 