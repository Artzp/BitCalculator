rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && 
        request.auth.uid in ['QsJxi2LzFhPDMur9xdx2TJbpS6Z2']; // art.leshchyna@gmail.com
    }
    
    // Users can access their own data, admins can access all user data
    match /users/{userId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin(); // Allow admins to list all users
    }
    
    // Test document for connectivity checks
    match /test/{document} {
      allow read, write: if request.auth != null;
    }
    
    // Public game data that everyone can read
    match /gameData/{document} {
      allow read: if true;
      allow list: if isAdmin(); // Allow admins to list all game data
      allow write: if isAdmin(); // Allow admins to write
    }
    
    // Shared builds that users can share publicly
    match /sharedBuilds/{buildId} {
      allow read: if true;
      allow list: if isAdmin(); // Allow admins to list all shared builds
      allow create: if request.auth != null 
        && validateSharedBuild(request.resource.data);
      allow update, delete: if request.auth != null 
        && (request.auth.uid == resource.data.authorId || isAdmin());
    }
    
    // Shared projects that users can share publicly
    match /sharedProjects/{projectId} {
      allow read: if true;
      allow list: if isAdmin(); // Allow admins to list all shared projects
      allow create: if request.auth != null 
        && validateSharedProject(request.resource.data);
      allow update, delete: if request.auth != null 
        && (request.auth.uid == resource.data.authorId || isAdmin());
    }
    
    // Project collaborations - invite system
    match /projectCollaborations/{collaborationId} {
      // Allow reading individual documents the user has access to, or admin access
      allow read: if request.auth != null 
        && (request.auth.uid == resource.data.ownerId 
            || request.auth.uid in resource.data.collaborators
            || resource.data.isActive == true // Allow reading active collaborations for invite code lookup
            || isAdmin()); // Admin can read all collaborations
      
      // Allow listing/querying collaborations where user is involved, or admin access
      allow list: if request.auth != null || isAdmin(); // Users can list to find their collaborations, admins can list all
      
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null 
        && (request.auth.uid == resource.data.ownerId 
            || request.auth.uid in resource.data.collaborators
            || (resource.data.isActive == true && isJoiningCollaboration())
            || isAdmin()); // Allow admin updates
      allow delete: if request.auth != null 
        && (request.auth.uid == resource.data.ownerId 
            || isAdmin()); // Allow admin deletes for orphaned collaboration cleanup
    }
    
    // User preferences and settings
    match /userSettings/{userId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin(); // Allow admins to list all user settings
    }
    
    // Statistics and analytics (read-only for users)
    match /statistics/{document} {
      allow read: if request.auth != null;
      allow list: if isAdmin(); // Allow admins to list all statistics
      allow write: if isAdmin(); // Allow admins to write for debugging
    }
    
    // Functions to validate data
    function validateSharedBuild(data) {
      return data.keys().hasAll(['name', 'description', 'buildList', 'authorId', 'createdAt'])
        && data.name is string
        && data.description is string
        && data.buildList is list
        && data.authorId is string
        && data.createdAt is timestamp;
    }
    
    function validateSharedProject(data) {
      return data.keys().hasAll(['name', 'description', 'items', 'authorId', 'createdAt'])
        && data.name is string
        && data.description is string
        && data.items is list
        && data.authorId is string
        && data.createdAt is timestamp
        && data.isPublic is bool;
    }
    
    // Function to validate collaboration joining
    function isJoiningCollaboration() {
      return request.auth != null
        && request.resource.data.collaborators is list
        && request.auth.uid in request.resource.data.collaborators
        && !(request.auth.uid in resource.data.collaborators) // User wasn't already a collaborator
        && request.resource.data.collaborators.size() == resource.data.collaborators.size() + 1; // Only added one user
    }
  }
} 