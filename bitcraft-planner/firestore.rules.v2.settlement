rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ================================
    // SETTLEMENT V2 SECURITY RULES
    // ================================
    
    // Users collection - users can only access their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Settlements collection - only settlement owners can access
    match /settlements/{settlementId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.ownerId || 
         request.auth.uid == request.resource.data.ownerId);
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.ownerId;
    }
    
    // Projects collection - access for owners and collaborators
    match /projects/{projectId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.ownerId || 
         request.auth.uid == request.resource.data.ownerId);
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.ownerId;
      
      // Allow read access for collaborators
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/project_collaborators/$(request.auth.uid + '_' + projectId));
    }
    
    // Tasks collection - access for project owners and assigned users
    match /tasks/{taskId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.assignedTo || 
         request.auth.uid == request.resource.data.assignedTo);
      allow create: if request.auth != null;
      
      // Allow access if user owns the parent project
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/projects/$(resource.data.projectId)) &&
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid;
    }
    
    // Project collaborators collection
    match /project_collaborators/{collaborationId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == resource.data.invitedBy);
      allow write: if request.auth != null && 
        request.auth.uid == resource.data.invitedBy;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.invitedBy;
    }
    
    // Shared projects collection - public read access
    match /shared_projects/{shareId} {
      allow read: if resource.data.accessType == 'public';
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.sharedBy;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.sharedBy;
    }
    
    // Build lists collection - users can only access their own build lists
    match /build_lists/{buildListId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == request.resource.data.userId);
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
    
    // ================================
    // HELPER FUNCTIONS
    // ================================
    
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.email in ['art.leshchyna@gmail.com'];
    }
    
    function isProjectOwner(projectId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }
    
    function isProjectCollaborator(projectId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/project_collaborators/$(request.auth.uid + '_' + projectId)) &&
        get(/databases/$(database)/documents/project_collaborators/$(request.auth.uid + '_' + projectId)).data.status == 'active';
    }
    
    function isSettlementOwner(settlementId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/settlements/$(settlementId)) &&
        get(/databases/$(database)/documents/settlements/$(settlementId)).data.ownerId == request.auth.uid;
    }
    
    // ================================
    // ADMIN OVERRIDES
    // ================================
    
    // Admin access to all collections for debugging and management
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
} 