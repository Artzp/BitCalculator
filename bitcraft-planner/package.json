    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-router-dom": "^5.3.3",
    "firebase": "^11.10.0",
    "react": "^19.1.0",
