rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && 
        request.auth.uid in ['QsJxi2LzFhPDMur9xdx2TJbpS6Z2']; // art.leshchyna@gmail.com
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is owner
    function isOwner(ownerId) {
      return request.auth != null && request.auth.uid == ownerId;
    }
    

    
    // Users can access their own data, admins can access all user data
    // Users can also read other users' basic profile information for collaboration features
    match /users/{userId} {
      // Allow users to read any other user's profile (for collaboration features)
      allow read: if request.auth != null;
      
      // Only allow users to write to their own data or admins to write to any
      allow write: if request.auth != null && 
        (request.auth.uid == userId || isAdmin());
        
      allow list: if isAdmin(); // Allow admins to list all users
    }
    
    // Test document for connectivity checks
    match /test/{document} {
      allow read, write: if request.auth != null;
    }
    
    // Public game data that everyone can read
    match /gameData/{document} {
      allow read: if true;
      allow list: if isAdmin(); // Allow admins to list all game data
      allow write: if isAdmin(); // Allow admins to write
    }
    
    // Shared builds that users can share publicly
    match /sharedBuilds/{buildId} {
      allow read: if true;
      allow list: if isAdmin(); // Allow admins to list all shared builds
      allow create: if request.auth != null 
        && validateSharedBuild(request.resource.data);
      allow update, delete: if request.auth != null 
        && (request.auth.uid == resource.data.authorId || isAdmin());
    }
    
    // Shared projects that users can share publicly
    match /sharedProjects/{projectId} {
      allow read: if true;
      allow list: if isAdmin(); // Allow admins to list all shared projects
      allow create: if request.auth != null 
        && validateSharedProject(request.resource.data);
      allow update, delete: if request.auth != null 
        && (request.auth.uid == resource.data.authorId || isAdmin());
    }
    
    // Project collaborations - invite system
    match /projectCollaborations/{collaborationId} {
      // Allow reading individual documents the user has access to, or admin access
      allow read: if request.auth != null 
        && (request.auth.uid == resource.data.ownerId 
            || request.auth.uid in resource.data.collaborators
            || resource.data.isActive == true // Allow reading active collaborations for invite code lookup
            || isAdmin()); // Admin can read all collaborations
      
      // Allow listing/querying collaborations where user is involved, or admin access
      allow list: if request.auth != null || isAdmin(); // Users can list to find their collaborations, admins can list all
      
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null 
        && (request.auth.uid == resource.data.ownerId 
            || request.auth.uid in resource.data.collaborators
            || (resource.data.isActive == true && isJoiningCollaboration())
            || isAdmin()); // Allow admin updates
      allow delete: if request.auth != null 
        && (request.auth.uid == resource.data.ownerId 
            || isAdmin()); // Allow admin deletes for orphaned collaboration cleanup
    }
    
    // User preferences and settings
    match /userSettings/{userId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin(); // Allow admins to list all user settings
    }
    
    // Statistics and analytics (read-only for users)
    match /statistics/{document} {
      allow read: if request.auth != null;
      allow list: if isAdmin(); // Allow admins to list all statistics
      allow write: if isAdmin(); // Allow admins to write for debugging
    }
    
    // ================================
    // SETTLEMENT V2 COLLECTIONS - PRIVACY FIXED
    // ================================
    
    // Settlements collection - FIXED: Users can only see their own settlements or collaborations
    match /settlements/{settlementId} {
      // Read access: owners, public settlements, or authenticated users (collaboration checked in app)
      allow read: if request.auth != null; // Allow all authenticated users to read - app handles collaboration filtering
      
      // Create access: authenticated users creating their own settlements
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.ownerId;
      
      // Update access: owners only for now
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.ownerId;
      
      // Delete access: only owners
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.ownerId;
      
      // List access: FIXED - Users can query their own settlements and settlements they collaborate on
      allow list: if request.auth != null && (
        resource == null || 
        request.auth.uid == resource.data.ownerId ||
        hasActiveSettlementCollaboration(resource.id)
      );
    }
    
    // Projects collection - FIXED: Users can see their own projects and settlement collaboration projects
    match /projects/{projectId} {
      // Read access: owners, collaborators, and settlement collaborators
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.ownerId ||
         (resource.data.visibility != null && resource.data.visibility == 'public') ||
         exists(/databases/$(database)/documents/project_collaborators/$(request.auth.uid + '_' + projectId)) ||
         (resource.data.settlementId != null && hasActiveSettlementCollaboration(resource.data.settlementId)));
      
      // Create access: authenticated users creating their own projects
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.ownerId;
      
      // Update access: SIMPLIFIED - Allow authenticated users to update projects
      // Read permissions ensure users can only see projects they should have access to
      allow update: if request.auth != null;
      
      // Delete access: only owners
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.ownerId;
      
      // List access: SIMPLIFIED - Allow all authenticated users to query projects 
      // Individual read permissions will handle the actual access control
      allow list: if request.auth != null;
    }
    
    // Tasks collection - FIXED: Users can see their own tasks and settlement collaboration tasks
    match /tasks/{taskId} {
      // Read access: assigned users, project owners, and settlement collaborators
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.assignedTo ||
         (exists(/databases/$(database)/documents/projects/$(resource.data.projectId)) &&
          get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid) ||
         (exists(/databases/$(database)/documents/projects/$(resource.data.projectId)) &&
          get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.settlementId != null &&
          hasActiveSettlementCollaboration(get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.settlementId)));
      
      // Create access: authenticated users
      allow create: if request.auth != null;
      
      // Update access: SIMPLIFIED - Allow authenticated users to update tasks
      // Read permissions ensure users can only see tasks they should have access to
      allow update: if request.auth != null;
      
      // Delete access: SIMPLIFIED - Allow authenticated users to delete tasks
      // Read permissions ensure users can only see tasks they should have access to
      allow delete: if request.auth != null;
      
      // List access: SIMPLIFIED - Allow all authenticated users to query tasks
      // Individual read permissions will handle the actual access control  
      allow list: if request.auth != null;
    }

    // Tasks V2 collection - Same rules as tasks collection for V2 system
    match /tasks_v2/{taskId} {
      // Read access: assigned users, project owners, and settlement collaborators
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.assignedTo ||
         (exists(/databases/$(database)/documents/projects/$(resource.data.projectId)) &&
          get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid) ||
         (exists(/databases/$(database)/documents/projects/$(resource.data.projectId)) &&
          get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.settlementId != null &&
          hasActiveSettlementCollaboration(get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.settlementId)));
      
      // Create access: authenticated users
      allow create: if request.auth != null;
      
      // Update access: SIMPLIFIED - Allow authenticated users to update tasks
      allow update: if request.auth != null;
      
      // Delete access: SIMPLIFIED - Allow authenticated users to delete tasks
      allow delete: if request.auth != null;
      
      // List access: SIMPLIFIED - Allow all authenticated users to query tasks
      allow list: if request.auth != null;
    }
    
    // Project collaborators collection
    match /project_collaborators/{collaborationId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == resource.data.invitedBy);
      allow write: if request.auth != null && 
        request.auth.uid == resource.data.invitedBy;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.invitedBy;
      allow list: if request.auth != null;
    }
    
    // Shared projects collection - public read access
    match /shared_projects/{shareId} {
      allow read: if resource.data.accessType == 'public';
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.sharedBy;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.sharedBy;
      allow list: if request.auth != null;
    }
    
    // Build lists collection - users can only access their own build lists
    match /build_lists/{buildListId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == request.resource.data.userId);
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      allow list: if request.auth != null && 
        (resource == null || request.auth.uid == resource.data.userId);
    }

    // Settlement collaborations collection
    match /settlement_collaborations_v2/{collaborationId} {
      // 🔒 TEMPORARY DEBUG: Allow all operations for debugging
      allow read, write, create, list: if request.auth != null;
      
      // Original rules commented out for debugging:
      // allow read: if request.auth != null && 
      //   (request.auth.uid == resource.data.userId || 
      //    request.auth.uid == resource.data.invitedBy ||
      //    isSettlementOwner(resource.data.settlementId));
      // allow write: if request.auth != null && 
      //   (request.auth.uid == resource.data.invitedBy ||
      //    request.auth.uid == resource.data.userId ||
      //    isSettlementOwner(resource.data.settlementId));
      // allow create: if request.auth != null && 
      //   (request.auth.uid == request.resource.data.invitedBy ||
      //    request.auth.uid == request.resource.data.userId ||
      //    isSettlementOwner(request.resource.data.settlementId) ||
      //    collaborationId == request.auth.uid + '_' + request.resource.data.settlementId);
      // allow list: if request.auth != null;
    }

    // Settlement invite links collection
    match /settlement_invite_links_v2/{linkId} {
      // 🔒 TEMPORARY DEBUG: Allow all operations for debugging
      allow read, write, create, list: if request.auth != null;
      
      // Original rules commented out for debugging:
      // allow read: if request.auth != null && 
      //   (request.auth.uid == resource.data.createdBy || 
      //    resource.data.isActive == true);
      // allow write: if request.auth != null && 
      //   request.auth.uid == resource.data.createdBy;
      // allow create: if request.auth != null && 
      //   request.auth.uid == request.resource.data.createdBy;
      // allow list: if request.auth != null;
    }

    // Task contributions collection - For contribution submission and approval system
    match /task_contributions_v2/{contributionId} {
      // Read access: Users can read their own contributions, settlement owners/collaborators can read all settlement contributions
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.userId ||
         isSettlementOwner(resource.data.settlementId) ||
         hasActiveSettlementCollaboration(resource.data.settlementId));
      
      // Create access: Users can create contributions for tasks assigned to them
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      
      // Update access: Settlement owners and collaborators can approve/reject contributions
      allow update: if request.auth != null && 
        (isSettlementOwner(resource.data.settlementId) ||
         hasActiveSettlementCollaboration(resource.data.settlementId));
      
      // Delete access: Users can delete their own pending contributions, settlement owners/collaborators can delete any
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.userId && resource.data.status == 'pending') ||
        isSettlementOwner(resource.data.settlementId) ||
        hasActiveSettlementCollaboration(resource.data.settlementId);
      
      // List access: Users can query contributions they have access to
      allow list: if request.auth != null;
    }
    
    // Functions to validate data
    function validateSharedBuild(data) {
      return data.keys().hasAll(['name', 'description', 'buildList', 'authorId', 'createdAt'])
        && data.name is string
        && data.description is string
        && data.buildList is list
        && data.authorId is string
        && data.createdAt is timestamp;
    }
    
    function validateSharedProject(data) {
      return data.keys().hasAll(['name', 'description', 'items', 'authorId', 'createdAt'])
        && data.name is string
        && data.description is string
        && data.items is list
        && data.authorId is string
        && data.createdAt is timestamp
        && data.isPublic is bool;
    }
    
    // Function to validate collaboration joining
    function isJoiningCollaboration() {
      return request.auth != null
        && request.resource.data.collaborators is list
        && request.auth.uid in request.resource.data.collaborators
        && !(request.auth.uid in resource.data.collaborators) // User wasn't already a collaborator
        && request.resource.data.collaborators.size() == resource.data.collaborators.size() + 1; // Only added one user
    }
    
    // Helper function to check if user has active settlement collaboration
    function hasActiveSettlementCollaboration(settlementId) {
      return exists(/databases/$(database)/documents/settlement_collaborations_v2/$(request.auth.uid + '_' + settlementId))
        && get(/databases/$(database)/documents/settlement_collaborations_v2/$(request.auth.uid + '_' + settlementId)).data.status == 'active';
    }
    
    // Helper function to check if user has write access to settlement (Owner, Co-Owner, Admin, Contributor)
    function hasSettlementWriteAccess(settlementId) {
      return exists(/databases/$(database)/documents/settlement_collaborations_v2/$(request.auth.uid + '_' + settlementId))
        && get(/databases/$(database)/documents/settlement_collaborations_v2/$(request.auth.uid + '_' + settlementId)).data.status == 'active'
        && get(/databases/$(database)/documents/settlement_collaborations_v2/$(request.auth.uid + '_' + settlementId)).data.role in ['Owner', 'Co-Owner', 'Admin', 'Contributor'];
    }
    
    // Helper function to check if user is the owner of a settlement
    function isSettlementOwner(settlementId) {
      return exists(/databases/$(database)/documents/settlements/$(settlementId))
        && get(/databases/$(database)/documents/settlements/$(settlementId)).data.ownerId == request.auth.uid;
    }
  }
} 