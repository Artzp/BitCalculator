  async getUserTasks(userId: string): Promise<NormalizedTask[]> {
    const tasksRef = collection(db, 'tasks_v2');
    const q = query(tasksRef, where('assignedTo', '==', userId), orderBy('createdAt', 'desc'));
    
    const querySnapshot = await getDocs(q);
    return querySnapshot.docs.map(doc => doc.data() as NormalizedTask);
  }

  async updateTask(taskId: string, updates: Partial<NormalizedTask>): Promise<void> {
    const taskRef = doc(db, 'tasks_v2', taskId);
    
    await updateDoc(taskRef, {
      ...updates,
      updatedAt: serverTimestamp()
    });
  }

  async deleteTask(taskId: string): Promise<void> {
    const taskRef = doc(db, 'tasks_v2', taskId);
    await deleteDoc(taskRef);
  }

  // ========================================================================
  // COLLABORATION MANAGEMENT
  // ========================================================================

  async createCollaboration(collaborationData: Omit<NormalizedProjectCollaboration, 'id' | 'createdAt' | 'updatedAt'>): Promise<string> {
    const collaborationId = `${collaborationData.userId}_${collaborationData.projectId}`;
    const collaborationRef = doc(db, 'project_collaborations_v2', collaborationId);
    
    const newCollaboration: NormalizedProjectCollaboration = {
      ...collaborationData,
      id: collaborationId,
      createdAt: serverTimestamp(),
      updatedAt: serverTimestamp()
    };
    
    await runTransaction(db, async (transaction) => {
      const collaborationDoc = await transaction.get(collaborationRef);
      if (collaborationDoc.exists()) {
        throw new Error('Collaboration already exists');
      }
      transaction.set(collaborationRef, newCollaboration);
    });
    
    return collaborationId;
  }

  async getCollaborationById(collaborationId: string): Promise<NormalizedProjectCollaboration | null> {
    const collaborationRef = doc(db, 'project_collaborations_v2', collaborationId);
    const collaborationDoc = await getDoc(collaborationRef);
    
    if (collaborationDoc.exists()) {
      return collaborationDoc.data() as NormalizedProjectCollaboration;
    }
    
    return null;
  }

  async getUserCollaborations(userId: string): Promise<NormalizedProjectCollaboration[]> {
    const collaborationsRef = collection(db, 'project_collaborations_v2');
    const q = query(
      collaborationsRef, 
      where('userId', '==', userId),
      where('status', '==', 'active'),
      orderBy('createdAt', 'desc')
    );
    
    const querySnapshot = await getDocs(q);
    return querySnapshot.docs.map(doc => doc.data() as NormalizedProjectCollaboration);
  }

  async getProjectCollaborations(projectId: string): Promise<NormalizedProjectCollaboration[]> {
    const collaborationsRef = collection(db, 'project_collaborations_v2');
    const q = query(
      collaborationsRef, 
      where('projectId', '==', projectId),
      orderBy('createdAt', 'desc')
    );
    
    const querySnapshot = await getDocs(q);
    return querySnapshot.docs.map(doc => doc.data() as NormalizedProjectCollaboration);
  }

  async updateCollaboration(collaborationId: string, updates: Partial<NormalizedProjectCollaboration>): Promise<void> {
    const collaborationRef = doc(db, 'project_collaborations_v2', collaborationId);
    
    await updateDoc(collaborationRef, {
      ...updates,
      updatedAt: serverTimestamp()
    });
  }

  async deleteCollaboration(collaborationId: string): Promise<void> {
    const collaborationRef = doc(db, 'project_collaborations_v2', collaborationId);
    await deleteDoc(collaborationRef);
  }

  // ========================================================================
  // COLLABORATIVE PROJECT QUERIES
  // ========================================================================

  async getUserCollaborativeProjects(userId: string): Promise<CollaborativeProject[]> {
    const collaborations = await this.getUserCollaborations(userId);
    const projects: CollaborativeProject[] = [];
    
    for (const collaboration of collaborations) {
      const project = await this.getProjectById(collaboration.projectId);
      if (project) {
        const tasks = await this.getProjectTasks(project.id);
        
        projects.push({
          ...project,
          tasks,
          collaboration,
          isCollaborative: true
        });
      }
    }
    
    return projects;
  }

  async getCompleteUserProjects(userId: string): Promise<{
    ownedProjects: ProjectWithTasks[];
    collaborativeProjects: CollaborativeProject[];
  }> {
    // Get owned projects
    const ownedProjectsData = await this.getUserProjects(userId);
    const ownedProjects: ProjectWithTasks[] = [];
    
    for (const project of ownedProjectsData) {
      const tasks = await this.getProjectTasks(project.id);
      ownedProjects.push({
        ...project,
        tasks
      });
    }
    
    // Get collaborative projects
    const collaborativeProjects = await this.getUserCollaborativeProjects(userId);
    
    return {
      ownedProjects,
      collaborativeProjects
    };
  }

  // ========================================================================
  // SETTLEMENT WITH FULL DATA
  // ========================================================================

  async getSettlementWithProjects(settlementId: string): Promise<SettlementWithProjects | null> {
    const settlement = await this.getSettlementById(settlementId);
    if (!settlement) return null;
    
    const projects = await this.getSettlementProjects(settlementId);
    const projectsWithTasks: ProjectWithTasks[] = [];
    
    for (const project of projects) {
      const tasks = await this.getProjectTasks(project.id);
      projectsWithTasks.push({
        ...project,
        tasks
      });
    }
    
    return {
      ...settlement,
      projects: projectsWithTasks
    };
  }

  // ========================================================================
  // BUILD LIST MANAGEMENT
  // ========================================================================

  async createBuildList(buildListData: Omit<NormalizedBuildList, 'id' | 'createdAt' | 'updatedAt'>): Promise<string> {
    const buildListId = generateId('buildlist');
    const buildListRef = doc(db, 'build_lists_v2', buildListId);
    
    const newBuildList: NormalizedBuildList = {
      ...buildListData,
      id: buildListId,
      createdAt: serverTimestamp(),
      updatedAt: serverTimestamp()
    };
    
    await runTransaction(db, async (transaction) => {
      transaction.set(buildListRef, newBuildList);
    });
    
    return buildListId;
  }

  async getUserBuildList(userId: string): Promise<NormalizedBuildList | null> {
    const buildListsRef = collection(db, 'build_lists_v2');
    const q = query(buildListsRef, where('userId', '==', userId), limit(1));
    
    const querySnapshot = await getDocs(q);
    
    if (!querySnapshot.empty) {
      return querySnapshot.docs[0].data() as NormalizedBuildList;
    }
    
    return null;
  }

  async updateBuildList(buildListId: string, updates: Partial<NormalizedBuildList>): Promise<void> {
    const buildListRef = doc(db, 'build_lists_v2', buildListId);
    
    await updateDoc(buildListRef, {
      ...updates,
      updatedAt: serverTimestamp()
    });
  }

  // ========================================================================
  // REAL-TIME SUBSCRIPTIONS
  // ========================================================================

  subscribeToUserProjects(userId: string, callback: (projects: NormalizedProject[]) => void): Unsubscribe {
    const projectsRef = collection(db, 'projects_v2');
    const q = query(projectsRef, where('ownerId', '==', userId), orderBy('createdAt', 'desc'));
    
    return onSnapshot(q, (querySnapshot) => {
      const projects = querySnapshot.docs.map(doc => doc.data() as NormalizedProject);
      callback(projects);
    });
  }

  subscribeToProjectTasks(projectId: string, callback: (tasks: NormalizedTask[]) => void): Unsubscribe {
    const tasksRef = collection(db, 'tasks_v2');
    const q = query(tasksRef, where('projectId', '==', projectId), orderBy('createdAt', 'desc'));
    
    return onSnapshot(q, (querySnapshot) => {
      const tasks = querySnapshot.docs.map(doc => doc.data() as NormalizedTask);
      callback(tasks);
    });
  }

  subscribeToUserCollaborations(userId: string, callback: (collaborations: NormalizedProjectCollaboration[]) => void): Unsubscribe {
    const collaborationsRef = collection(db, 'project_collaborations_v2');
    const q = query(
      collaborationsRef, 
      where('userId', '==', userId),
      where('status', '==', 'active'),
      orderBy('createdAt', 'desc')
    );
    
    return onSnapshot(q, (querySnapshot) => {
      const collaborations = querySnapshot.docs.map(doc => doc.data() as NormalizedProjectCollaboration);
      callback(collaborations);
    });
  }

  // ========================================================================
  // BATCH OPERATIONS
  // ========================================================================

  async createMultipleTasks(tasks: Omit<NormalizedTask, 'id' | 'createdAt' | 'updatedAt'>[]): Promise<string[]> {
    const batch = writeBatch(db);
    const taskIds: string[] = [];
    
    for (const taskData of tasks) {
      const taskId = generateId('task');
      const taskRef = doc(db, 'tasks_v2', taskId);
      
      const newTask: NormalizedTask = {
        ...taskData,
        id: taskId,
        createdAt: serverTimestamp(),
        updatedAt: serverTimestamp()
      };
      
      batch.set(taskRef, newTask);
      taskIds.push(taskId);
    }
    
    await batch.commit();
    return taskIds;
  }

  async bulkUpdateTasks(updates: { taskId: string; updates: Partial<NormalizedTask> }[]): Promise<void> {
    const batch = writeBatch(db);
    
    for (const { taskId, updates: taskUpdates } of updates) {
      const taskRef = doc(db, 'tasks_v2', taskId);
      batch.update(taskRef, {
        ...taskUpdates,
        updatedAt: serverTimestamp()
      });
    }
    
    await batch.commit();
  }

  // ========================================================================
  // SEARCH AND FILTERING
  // ========================================================================

  async searchProjects(userId: string, searchTerm: string): Promise<NormalizedProject[]> {
    // Note: This is a simplified search - in production, use Algolia or similar
    const projectsRef = collection(db, 'projects_v2');
    const q = query(projectsRef, where('ownerId', '==', userId));
    
    const querySnapshot = await getDocs(q);
    const projects = querySnapshot.docs.map(doc => doc.data() as NormalizedProject);
    
    return projects.filter(project => 
      project.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
      project.description?.toLowerCase().includes(searchTerm.toLowerCase())
    );
  }

  async getProjectsByStatus(userId: string, status: ProjectStatus): Promise<NormalizedProject[]> {
    const projectsRef = collection(db, 'projects_v2');
    const q = query(
      projectsRef, 
      where('ownerId', '==', userId),
      where('status', '==', status),
      orderBy('createdAt', 'desc')
    );
    
    const querySnapshot = await getDocs(q);
    return querySnapshot.docs.map(doc => doc.data() as NormalizedProject);
  }

  async getTasksByStatus(projectId: string, status: TaskStatus): Promise<NormalizedTask[]> {
    const tasksRef = collection(db, 'tasks_v2');
    const q = query(
      tasksRef, 
      where('projectId', '==', projectId),
      where('status', '==', status),
      orderBy('createdAt', 'desc')
    );
    
    const querySnapshot = await getDocs(q);
    return querySnapshot.docs.map(doc => doc.data() as NormalizedTask);
  }
}

// ============================================================================
// SINGLETON INSTANCE
// ============================================================================

export const normalizedFirebaseService = new NormalizedFirebaseService();
export default normalizedFirebaseService; 