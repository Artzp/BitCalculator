  async getTaskById(taskId: string): Promise<NormalizedTask | null> {
    const taskRef = doc(db, 'tasks_v2', taskId);
    const taskDoc = await getDoc(taskRef);
    
    if (taskDoc.exists()) {
      return taskDoc.data() as NormalizedTask;
    }
    
    return null;
  }

  async getProjectTasks(projectId: string): Promise<NormalizedTask[]> {
    const tasksRef = collection(db, 'tasks_v2');
    const q = query(tasksRef, where('projectId', '==', projectId), orderBy('createdAt', 'desc'));
    
    const querySnapshot = await getDocs(q);
