// ============================================================================
// NORMALIZED FIREBASE SERVICE
// ============================================================================
// Complete service for interacting with the normalized database structure
// Replaces embedded document patterns with proper relational queries
// ============================================================================

import { 
  collection, 
  doc, 
  getDocs, 
  getDoc, 
  addDoc,
  updateDoc,
  deleteDoc,
  query, 
  where, 
  orderBy, 
  limit,
  onSnapshot,
  writeBatch,
  runTransaction,
  serverTimestamp,
  Timestamp,
  QueryConstraint,
  Unsubscribe,
  DocumentData
} from 'firebase/firestore';
import { db } from '../firebase/config';
import { 
  NormalizedUserData, 
  NormalizedSettlement, 
  NormalizedProject, 
  NormalizedTask,
  NormalizedProjectCollaboration,
  NormalizedBuildList,
  NormalizedSharedProject,
  CollaborativeProject,
  ProjectWithTasks,
  SettlementWithProjects,
  UserRole,
  ProjectStatus,
  TaskStatus,
  CollaborationStatus
} from '../types/NormalizedDatabase';
import { generateId } from '../utils/migrationUtilities';

// ============================================================================
// NORMALIZED FIREBASE SERVICE CLASS
// ============================================================================

export class NormalizedFirebaseService {
  
  // ========================================================================
  // USER MANAGEMENT
  // ========================================================================

  async createUser(userData: Omit<NormalizedUserData, 'id' | 'createdAt' | 'updatedAt'>): Promise<string> {
    const userRef = doc(db, 'users_v2', userData.email); // Use email as ID for consistency
    
    const newUser: NormalizedUserData = {
      ...userData,
      id: userData.email,
      createdAt: serverTimestamp(),
      updatedAt: serverTimestamp()
    };
    
    await runTransaction(db, async (transaction) => {
      const userDoc = await transaction.get(userRef);
      if (userDoc.exists()) {
        throw new Error('User already exists');
      }
      transaction.set(userRef, newUser);
    });
    
    return userData.email;
  }

  async getUserById(userId: string): Promise<NormalizedUserData | null> {
    const userRef = doc(db, 'users_v2', userId);
    const userDoc = await getDoc(userRef);
    
    if (userDoc.exists()) {
      return userDoc.data() as NormalizedUserData;
    }
    
    return null;
  }

  async updateUser(userId: string, updates: Partial<NormalizedUserData>): Promise<void> {
    const userRef = doc(db, 'users_v2', userId);
    
    await updateDoc(userRef, {
      ...updates,
      updatedAt: serverTimestamp()
    });
  }

  // ========================================================================
  // SETTLEMENT MANAGEMENT
  // ========================================================================

  async createSettlement(settlementData: Omit<NormalizedSettlement, 'id' | 'createdAt' | 'updatedAt'>): Promise<string> {
    const settlementId = generateId('settlement');
    const settlementRef = doc(db, 'settlements_v2', settlementId);
    
    const newSettlement: NormalizedSettlement = {
      ...settlementData,
      id: settlementId,
      createdAt: serverTimestamp(),
      updatedAt: serverTimestamp()
    };
    
    await runTransaction(db, async (transaction) => {
      transaction.set(settlementRef, newSettlement);
    });
    
    return settlementId;
  }

  async getSettlementById(settlementId: string): Promise<NormalizedSettlement | null> {
    const settlementRef = doc(db, 'settlements_v2', settlementId);
    const settlementDoc = await getDoc(settlementRef);
    
    if (settlementDoc.exists()) {
      return settlementDoc.data() as NormalizedSettlement;
    }
    
    return null;
  }

  async getUserSettlements(userId: string): Promise<NormalizedSettlement[]> {
    const settlementsRef = collection(db, 'settlements_v2');
    const q = query(settlementsRef, where('ownerId', '==', userId), orderBy('createdAt', 'desc'));
    
    const querySnapshot = await getDocs(q);
    return querySnapshot.docs.map(doc => doc.data() as NormalizedSettlement);
  }

  async updateSettlement(settlementId: string, updates: Partial<NormalizedSettlement>): Promise<void> {
    const settlementRef = doc(db, 'settlements_v2', settlementId);
    
    await updateDoc(settlementRef, {
      ...updates,
      updatedAt: serverTimestamp()
    });
  }

  async deleteSettlement(settlementId: string): Promise<void> {
    await runTransaction(db, async (transaction) => {
      // Delete settlement
      const settlementRef = doc(db, 'settlements_v2', settlementId);
      transaction.delete(settlementRef);
      
      // Delete related projects
      const projectsRef = collection(db, 'projects_v2');
      const projectsQuery = query(projectsRef, where('settlementId', '==', settlementId));
      const projectsSnapshot = await getDocs(projectsQuery);
      
      for (const projectDoc of projectsSnapshot.docs) {
        transaction.delete(projectDoc.ref);
        
        // Delete related tasks
        const tasksRef = collection(db, 'tasks_v2');
        const tasksQuery = query(tasksRef, where('projectId', '==', projectDoc.id));
        const tasksSnapshot = await getDocs(tasksQuery);
        
        for (const taskDoc of tasksSnapshot.docs) {
          transaction.delete(taskDoc.ref);
        }
      }
      
      // Delete related build lists
      const buildListsRef = collection(db, 'build_lists_v2');
      const buildListsQuery = query(buildListsRef, where('settlementId', '==', settlementId));
      const buildListsSnapshot = await getDocs(buildListsQuery);
      
      for (const buildListDoc of buildListsSnapshot.docs) {
        transaction.delete(buildListDoc.ref);
      }
    });
  }

  // ========================================================================
  // PROJECT MANAGEMENT
  // ========================================================================

  async createProject(projectData: Omit<NormalizedProject, 'id' | 'createdAt' | 'updatedAt'>): Promise<string> {
    const projectId = generateId('project');
    const projectRef = doc(db, 'projects_v2', projectId);
    
    const newProject: NormalizedProject = {
      ...projectData,
      id: projectId,
      createdAt: serverTimestamp(),
      updatedAt: serverTimestamp()
    };
    
    await runTransaction(db, async (transaction) => {
      transaction.set(projectRef, newProject);
    });
    
    return projectId;
  }

  async getProjectById(projectId: string): Promise<NormalizedProject | null> {
    const projectRef = doc(db, 'projects_v2', projectId);
    const projectDoc = await getDoc(projectRef);
    
    if (projectDoc.exists()) {
      return projectDoc.data() as NormalizedProject;
    }
    
    return null;
  }

  async getProjectWithTasks(projectId: string): Promise<ProjectWithTasks | null> {
    const project = await this.getProjectById(projectId);
    if (!project) return null;
    
    const tasks = await this.getProjectTasks(projectId);
    
    return {
      ...project,
      tasks
    };
  }

  async getUserProjects(userId: string): Promise<NormalizedProject[]> {
    const projectsRef = collection(db, 'projects_v2');
    const q = query(projectsRef, where('ownerId', '==', userId), orderBy('createdAt', 'desc'));
    
    const querySnapshot = await getDocs(q);
    return querySnapshot.docs.map(doc => doc.data() as NormalizedProject);
  }

  async getSettlementProjects(settlementId: string): Promise<NormalizedProject[]> {
    const projectsRef = collection(db, 'projects_v2');
    const q = query(projectsRef, where('settlementId', '==', settlementId), orderBy('createdAt', 'desc'));
    
    const querySnapshot = await getDocs(q);
    return querySnapshot.docs.map(doc => doc.data() as NormalizedProject);
  }

  async updateProject(projectId: string, updates: Partial<NormalizedProject>): Promise<void> {
    const projectRef = doc(db, 'projects_v2', projectId);
    
    await updateDoc(projectRef, {
      ...updates,
      updatedAt: serverTimestamp()
    });
  }

  async deleteProject(projectId: string): Promise<void> {
    await runTransaction(db, async (transaction) => {
      // Delete project
      const projectRef = doc(db, 'projects_v2', projectId);
      transaction.delete(projectRef);
      
      // Delete related tasks
      const tasksRef = collection(db, 'tasks_v2');
      const tasksQuery = query(tasksRef, where('projectId', '==', projectId));
      const tasksSnapshot = await getDocs(tasksQuery);
      
      for (const taskDoc of tasksSnapshot.docs) {
        transaction.delete(taskDoc.ref);
      }
      
      // Delete related collaborations
      const collaborationsRef = collection(db, 'project_collaborations_v2');
      const collaborationsQuery = query(collaborationsRef, where('projectId', '==', projectId));
      const collaborationsSnapshot = await getDocs(collaborationsQuery);
      
      for (const collaborationDoc of collaborationsSnapshot.docs) {
        transaction.delete(collaborationDoc.ref);
      }
    });
  }

  // ========================================================================
  // TASK MANAGEMENT
  // ========================================================================

  async createTask(taskData: Omit<NormalizedTask, 'id' | 'createdAt' | 'updatedAt'>): Promise<string> {
    const taskId = generateId('task');
    const taskRef = doc(db, 'tasks_v2', taskId);
    
