import React from 'react';
import { useSettlementStore } from '../state/useSettlementStore';

const SettlementOverview: React.FC = () => {
  const { settlement } = useSettlementStore();

  if (!settlement) {
    return (
      <div className="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
        <div className="text-center">
          <div className="text-gray-500 text-lg">No settlement data available</div>
        </div>
      </div>
    );
  }

  const players = Object.values(settlement.players);
  const projects = Object.values(settlement.projects);
  const tasks = Object.values(settlement.tasks);
  const inventoryItems = Object.values(settlement.inventory);

  // Calculate metrics
  const activePlayers = players.filter(p => p.isActive).length;
  const activeProjects = projects.filter(p => p.status === 'in_progress').length;
  const completedProjects = projects.filter(p => p.status === 'completed').length;
  const pendingTasks = tasks.filter(t => t.status === 'planned').length;
  const inProgressTasks = tasks.filter(t => t.status === 'in_progress').length;
  const completedTasks = tasks.filter(t => t.status === 'completed').length;
  const blockedTasks = tasks.filter(t => t.status === 'blocked').length;
  const totalInventoryValue = inventoryItems.reduce((sum, item) => sum + item.quantity, 0);
  const lowStockItems = inventoryItems.filter(item => item.availableQuantity <= 10).length;

  // Recent activity (last 7 days)
  const recentDate = new Date();
  recentDate.setDate(recentDate.getDate() - 7);
  
  const recentProjects = projects.filter(p => new Date(p.dateCreated) >= recentDate);
  const recentTasks = tasks.filter(t => new Date(t.dateCreated) >= recentDate);

  return (
    <div className="space-y-6">
      {/* Settlement Info */}
      <div className="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
        <h2 className="text-xl font-bold text-slate-800 mb-4">Settlement Information</h2>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <h3 className="font-semibold text-slate-700 mb-2">Settlement Name</h3>
            <p className="text-slate-600">{settlement.name}</p>
          </div>
          <div>
            <h3 className="font-semibold text-slate-700 mb-2">Description</h3>
            <p className="text-slate-600">{settlement.description || 'No description provided'}</p>
          </div>
          <div>
            <h3 className="font-semibold text-slate-700 mb-2">Created</h3>
            <p className="text-slate-600">{new Date(settlement.dateCreated).toLocaleDateString()}</p>
          </div>
          <div>
            <h3 className="font-semibold text-slate-700 mb-2">Total Members</h3>
            <p className="text-slate-600">{players.length}</p>
          </div>
        </div>
      </div>

      {/* Key Metrics */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {/* Players Metric */}
        <div className="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm font-medium text-slate-600">Active Players</p>
              <p className="text-2xl font-bold text-slate-800">{activePlayers}</p>
              <p className="text-xs text-slate-500">of {players.length} total</p>
            </div>
            <div className="text-3xl">👥</div>
          </div>
        </div>

        {/* Projects Metric */}
        <div className="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm font-medium text-slate-600">Active Projects</p>
              <p className="text-2xl font-bold text-slate-800">{activeProjects}</p>
              <p className="text-xs text-slate-500">{completedProjects} completed</p>
            </div>
            <div className="text-3xl">🏗️</div>
          </div>
        </div>

        {/* Tasks Metric */}
        <div className="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm font-medium text-slate-600">Tasks</p>
              <p className="text-2xl font-bold text-slate-800">{inProgressTasks}</p>
              <p className="text-xs text-slate-500">in progress</p>
            </div>
            <div className="text-3xl">📋</div>
          </div>
        </div>

        {/* Inventory Metric */}
        <div className="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm font-medium text-slate-600">Inventory Items</p>
              <p className="text-2xl font-bold text-slate-800">{totalInventoryValue}</p>
              <p className="text-xs text-slate-500">total quantity</p>
            </div>
            <div className="text-3xl">📦</div>
          </div>
        </div>
      </div>

      {/* Status Dashboard */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {/* Project Status */}
        <div className="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
          <h3 className="text-lg font-bold text-slate-800 mb-4">Project Status</h3>
          <div className="space-y-3">
            <div className="flex items-center justify-between">
              <span className="text-sm text-slate-600">Not Started</span>
              <span className="bg-gray-100 text-gray-800 px-2 py-1 rounded text-sm">
                {projects.filter(p => p.status === 'not_started').length}
              </span>
            </div>
            <div className="flex items-center justify-between">
              <span className="text-sm text-slate-600">In Progress</span>
              <span className="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">
                {activeProjects}
              </span>
            </div>
            <div className="flex items-center justify-between">
              <span className="text-sm text-slate-600">Blocked</span>
              <span className="bg-red-100 text-red-800 px-2 py-1 rounded text-sm">
                {projects.filter(p => p.status === 'blocked').length}
              </span>
            </div>
            <div className="flex items-center justify-between">
              <span className="text-sm text-slate-600">Completed</span>
              <span className="bg-green-100 text-green-800 px-2 py-1 rounded text-sm">
                {completedProjects}
              </span>
            </div>
          </div>
        </div>

        {/* Task Status */}
        <div className="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
          <h3 className="text-lg font-bold text-slate-800 mb-4">Task Status</h3>
          <div className="space-y-3">
            <div className="flex items-center justify-between">
              <span className="text-sm text-slate-600">Planned</span>
              <span className="bg-gray-100 text-gray-800 px-2 py-1 rounded text-sm">
                {pendingTasks}
              </span>
            </div>
            <div className="flex items-center justify-between">
              <span className="text-sm text-slate-600">In Progress</span>
              <span className="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">
                {inProgressTasks}
              </span>
            </div>
            <div className="flex items-center justify-between">
              <span className="text-sm text-slate-600">Blocked</span>
              <span className="bg-red-100 text-red-800 px-2 py-1 rounded text-sm">
                {blockedTasks}
              </span>
            </div>
            <div className="flex items-center justify-between">
              <span className="text-sm text-slate-600">Completed</span>
              <span className="bg-green-100 text-green-800 px-2 py-1 rounded text-sm">
                {completedTasks}
              </span>
            </div>
          </div>
        </div>
      </div>

      {/* Recent Activity */}
      <div className="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
        <h3 className="text-lg font-bold text-slate-800 mb-4">Recent Activity (Last 7 Days)</h3>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h4 className="font-semibold text-slate-700 mb-2">New Projects</h4>
            {recentProjects.length > 0 ? (
              <div className="space-y-2">
                {recentProjects.slice(0, 3).map(project => (
                  <div key={project.id} className="flex items-center justify-between p-2 bg-gray-50 rounded">
                    <span className="text-sm text-slate-600">{project.name}</span>
                    <span className={`px-2 py-1 rounded text-xs ${
                      project.priority === 'high' ? 'bg-red-100 text-red-800' :
                      project.priority === 'medium' ? 'bg-yellow-100 text-yellow-800' :
                      'bg-green-100 text-green-800'
                    }`}>
                      {project.priority}
                    </span>
                  </div>
                ))}
                {recentProjects.length > 3 && (
                  <p className="text-xs text-slate-500">+{recentProjects.length - 3} more</p>
                )}
              </div>
            ) : (
              <p className="text-sm text-slate-500">No new projects</p>
            )}
          </div>
          
          <div>
            <h4 className="font-semibold text-slate-700 mb-2">New Tasks</h4>
            {recentTasks.length > 0 ? (
              <div className="space-y-2">
                {recentTasks.slice(0, 3).map(task => (
                  <div key={task.id} className="flex items-center justify-between p-2 bg-gray-50 rounded">
                    <span className="text-sm text-slate-600">{task.name}</span>
                    <span className={`px-2 py-1 rounded text-xs ${
                      task.status === 'completed' ? 'bg-green-100 text-green-800' :
                      task.status === 'in_progress' ? 'bg-blue-100 text-blue-800' :
                      task.status === 'blocked' ? 'bg-red-100 text-red-800' :
                      'bg-gray-100 text-gray-800'
                    }`}>
                      {task.status.replace('_', ' ')}
                    </span>
                  </div>
                ))}
                {recentTasks.length > 3 && (
                  <p className="text-xs text-slate-500">+{recentTasks.length - 3} more</p>
                )}
              </div>
            ) : (
              <p className="text-sm text-slate-500">No new tasks</p>
            )}
          </div>
        </div>
      </div>

      {/* Alerts */}
      {(lowStockItems > 0 || blockedTasks > 0) && (
        <div className="bg-white rounded-xl p-6 shadow-lg border border-slate-200">
          <h3 className="text-lg font-bold text-slate-800 mb-4">⚠️ Alerts</h3>
          <div className="space-y-2">
            {lowStockItems > 0 && (
              <div className="flex items-center p-3 bg-yellow-50 border border-yellow-200 rounded">
                <span className="text-yellow-600 mr-2">⚠️</span>
                <span className="text-sm text-yellow-800">
                  {lowStockItems} inventory items are running low on stock
                </span>
              </div>
            )}
            {blockedTasks > 0 && (
              <div className="flex items-center p-3 bg-red-50 border border-red-200 rounded">
                <span className="text-red-600 mr-2">🚫</span>
                <span className="text-sm text-red-800">
                  {blockedTasks} tasks are currently blocked
                </span>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
};

export default SettlementOverview; 